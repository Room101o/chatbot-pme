# ─── OBLIGATOIRE ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Configuration du bot (affiché au client) ────────────────
BOT_NAME=Assistant Karim
BIZ_NAME=Garage AutoPro
SECTOR=Automobile / Garage
WELCOME_MESSAGE=Bonjour ! Je suis l'assistant de Garage AutoPro. Comment puis-je vous aider ?

# ─── Sécurité CORS (domaines autorisés) ──────────────────────
# Mettre le domaine du site client, ex: https://monsite.ma
# Laisser vide = tous les domaines (pour les tests)
ALLOWED_ORIGINS=https://monsite.ma,https://www.monsite.ma

# ─── Port (Railway/Render le définit automatiquement) ────────
PORT=3000
